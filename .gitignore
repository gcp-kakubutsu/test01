# Dependencies
/node_modules
/.pnp
.pnp.js

# Testing
/coverage

# Next.js
/.next/
/out/

# Turbopack
.turbo

# Production
/build

# Nuxt
.nuxt
dist

# Gatsby
.cache/
# Add storybook build directory here too.

# Environment Variables
.env
.env*.local
.env.development.local
.env.test.local
.env.production.local

# IDEs and editors
.idea
.vscode
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# System files
.DS_Store
Thumbs.db

# Log files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Firebase
firebase-debug.log
firebase-crashlytics-build.json

# TypeScript
tsconfig.tsbuildinfo

.specstory/
.cursorindexingignore

# Service Account Keys (CRITICAL - Never commit these!)
nukune-*.json
*-firebase-adminsdk-*.json
serviceAccountKey.json
*-service-account*.json

# publicディレクトリ内のファイルを無視するが、imgディレクトリは除外する
public/*
!public/img
