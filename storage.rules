rules_version = '2';

// Craft rules based on data in your Firestore database
// allow write: if firestore.get(
//    /databases/(default)/documents/users/$(request.auth.uid)).data.isAdmin == true;
service firebase.storage {
  match /b/{bucket}/o {
    // Profile images - allow authenticated users to read all profile images
    // and write their own profile images
    match /profiles/{userId}/{allPaths=**} {
      // Allow users to upload/update their own profile images
      allow write: if request.auth != null && request.auth.uid == userId;
      
      // Allow all authenticated users to read profile images (for matching)
      allow read: if request.auth != null;
    }
    
    // Temporary uploads folder for admin registration
    match /profiles/temp_{tempId}/{allPaths=**} {
      // Allow authenticated users to upload to temp folder
      allow write: if request.auth != null;
      allow read: if request.auth != null;
    }
    
    // Default rule - deny all other access
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}