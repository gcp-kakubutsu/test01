rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is admin
    // Note: This checks custom claims set by Cloud Functions
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }
    
    // Users collection rules
    match /users/{userId} {
      // 認証されたユーザーは全てのユーザープロフィールを読める（マッチング用）
      allow read: if request.auth != null;
      
      // ユーザーは自分のデータのみ書き込める
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Messages collection rules
    match /messages/{messageId} {
      // 会話の参加者のみ読み書き可能
      allow read, write: if request.auth != null && 
        (request.auth.uid in resource.data.participants ||
         request.auth.uid in request.resource.data.participants);
    }
    
    // Matches collection rules
    match /matches/{matchId} {
      // マッチに関わるユーザーのみ読み書き可能
      allow read, write: if request.auth != null && 
        (request.auth.uid in resource.data.users ||
         request.auth.uid in request.resource.data.users);
         
      // Messages subcollection
      match /messages/{messageId} {
        allow read, write: if request.auth != null && 
          request.auth.uid in get(/databases/$(database)/documents/matches/$(matchId)).data.users;
      }
    }
    
    // Likes collection rules
    match /likes/{likeId} {
      // ユーザーは自分が送信したいいね、または自分宛のいいねを読める
      // また、mysql_girl_で始まるtoフィールドの場合も読める（MySQLの女の子データ）
      allow read: if request.auth != null && 
        (request.auth.uid == resource.data.from ||
         request.auth.uid == resource.data.to ||
         (resource.data.to is string && resource.data.to.matches('^mysql_girl_.*')));
      
      // ユーザーは自分からのいいねのみ作成できる
      allow create: if request.auth != null && 
        request.auth.uid == request.resource.data.from;
      
      // ユーザーは自分が送信したいいねのみ更新できる（タイムスタンプの更新用）
      allow update: if request.auth != null && 
        request.auth.uid == resource.data.from &&
        request.auth.uid == request.resource.data.from;
      
      // いいねは削除不可
      allow delete: if false;
    }
    
    // Communities collection rules
    match /communities/{communityId} {
      // 認証されたユーザーは全てのコミュニティを読める
      allow read: if request.auth != null;
      
      // コミュニティの作成は認証されたユーザーのみ
      allow create: if request.auth != null;
      
      // コミュニティの更新（参加・退会など）は認証されたユーザーのみ
      allow update: if request.auth != null;
      
      // コミュニティの削除は作成者または管理者のみ
      allow delete: if request.auth != null && 
        (resource.data.createdBy == request.auth.uid || isAdmin());
    }
    
    // Posts collection rules
    match /posts/{postId} {
      // 認証されたユーザーは全ての投稿を読める
      allow read: if request.auth != null;
      
      // 投稿の作成は認証されたユーザーのみ（自分のauthorIdで）
      allow create: if request.auth != null && 
        request.auth.uid == request.resource.data.authorId;
      
      // 投稿の更新（いいねなど）は認証されたユーザーのみ
      allow update: if request.auth != null;
      
      // 投稿の削除は作成者または管理者のみ
      allow delete: if request.auth != null && 
        (request.auth.uid == resource.data.authorId || isAdmin());
      
      // Comments subcollection
      match /comments/{commentId} {
        // 認証されたユーザーはコメントを読める
        allow read: if request.auth != null;
        
        // コメントの作成は認証されたユーザーのみ（自分のauthorIdで）
        allow create: if request.auth != null && 
          request.auth.uid == request.resource.data.authorId;
        
        // コメントの更新は作成者のみ
        allow update: if request.auth != null && 
          request.auth.uid == resource.data.authorId;
        
        // コメントの削除は作成者または管理者のみ
        allow delete: if request.auth != null && 
          (request.auth.uid == resource.data.authorId || isAdmin());
      }
    }
    
    // Profile views collection rules
    match /profileViews/{viewId} {
      // 認証されたユーザーは全ての閲覧データを読める（プロフィール閲覧数表示のため）
      allow read: if request.auth != null;
      
      // プロフィール閲覧の記録は認証されたユーザーのみ（自分がviewerの場合のみ）
      allow create: if request.auth != null && 
        request.auth.uid == request.resource.data.viewerUserId;
      
      // 閲覧記録の更新・削除は不可
      allow update, delete: if false;
    }
    
    // User settings collection rules
    match /userSettings/{userId} {
      // ユーザーは自分の設定のみ読み書き可能
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Male user preferences collection rules
    match /malePreferences/{userId} {
      // ユーザーは自分の設定のみ読み書き可能
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Memos collection rules - Personal notes about girls
    match /memos/{memoId} {
      // Memo ID format: userId_targetId
      // Allow read if:
      // 1. User is authenticated AND
      // 2. Either the resource doesn't exist (checking before create) OR
      // 3. The memo belongs to the user (for list queries and single doc reads)
      allow read: if request.auth != null && (
        !exists(/databases/$(database)/documents/memos/$(memoId)) ||
        resource.data.userId == request.auth.uid ||
        memoId.matches(request.auth.uid + '_.*')
      );
      
      // Users can only create memos for themselves
      allow create: if request.auth != null && 
        request.resource.data.userId == request.auth.uid &&
        memoId == request.auth.uid + '_' + request.resource.data.targetId;
      
      // Users can only update their own memos
      allow update: if request.auth != null && 
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == request.auth.uid;
      
      // Users can only delete their own memos
      allow delete: if request.auth != null && 
        resource.data.userId == request.auth.uid;
    }
    
    // Memo History collection rules - History of memos about girls
    match /memoHistory/{memoId} {
      // Users can read their own memo history
      allow read: if request.auth != null && 
        resource.data.userId == request.auth.uid;
      
      // Users can create memo history for themselves
      allow create: if request.auth != null && 
        request.resource.data.userId == request.auth.uid;
      
      // Users can update their own memo history
      allow update: if request.auth != null && 
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == request.auth.uid;
      
      // Users can delete their own memo history
      allow delete: if request.auth != null && 
        resource.data.userId == request.auth.uid;
    }
    
    // Public stats collection - 統計情報は誰でも読める
    match /publicStats/{document=**} {
      allow read: if true;
      allow write: if false;
    }
    
    // Default rule - deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}